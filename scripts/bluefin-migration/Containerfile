# ═══════════════════════════════════════════════════════════════════
# bluefin-custom — Multi-stage build
# Stage 1: RPM layer (Silverblue + packages)
# Stage 2: Host-built layer (binaries + shared libs)
# Stage 3: Config layer (dotfiles + first-boot)
# ═══════════════════════════════════════════════════════════════════

# ── Stage 1: RPM layer ────────────────────────────────────────────
FROM registry.fedoraproject.org/fedora-silverblue:44 AS rpm-layer

RUN rm -f /etc/yum.repos.d/*multimedia* /etc/yum.repos.d/*negativo* 2>/dev/null || true

COPY rpmfusion-free.rpm /tmp/rpmfusion-free.rpm
RUN rpm-ostree install -y /tmp/rpmfusion-free.rpm && rpm-ostree cleanup -m && rm /tmp/rpmfusion-free.rpm || true

COPY rpmfusion-nonfree.rpm /tmp/rpmfusion-nonfree.rpm
RUN rpm-ostree install -y /tmp/rpmfusion-nonfree.rpm && rm /tmp/rpmfusion-nonfree.rpm || true

RUN rpm-ostree install -y \
    ImageMagick NetworkManager ShellCheck abduco advancecomp age \
    alsa-firmware alsa-tools-firmware android-tools aria2 ark asciinema atop avahi bat beets \
    bluez borgbackup bpftrace breeze-icon-theme btop cargo cava ccid cdparanoia chafa \
    chezmoi clang cliphist cmake convmv corectrl cowsay cpio cups cups-pk-helper \
    curl dash ddccontrol ddrescue device-mapper-multipath dhcp-client diff-so-fancy \
    difftastic direnv distrobox dkms dnsmasq dos2unix dosbox dunst edk2-ovmf efibootmgr \
    elfutils enca entr etckeeper expect eza fastfetch fd-find ffmpegthumbnailer figlet \
    fio firewalld fortune-mod fping freerdp fuse-sshfs fwupd gamemode gamescope gdb \
    gdisk gdm geoip gh git git-crypt git-extras git-filter-repo git-lfs glow \
    gnome-calculator gnome-console gnome-control-center gnome-disk-utility gnome-keyring \
    gnome-settings-daemon gnome-system-monitor gnome-text-editor gnome-tweaks gnome-user-share \
    goaccess golang google-noto-cjk-fonts gopass graphviz grim \
    gstreamer1-libav gstreamer1-plugins-bad-free gstreamer1-plugins-ugly-free \
    gvfs gvfs-afc gvfs-goa gvfs-gphoto2 gvfs-mtp gvfs-nfs gvfs-smb hashcat helix \
    helvum hexyl htop hunspell-ru hwinfo hyperfine i3 i3status id3v2 iftop \
    inotify-tools inxi ioping iotop-c iperf3 isync iwd jc jdupes \
    jetbrains-mono-fonts jpegoptim jq jupyterlab just kernel-tools kexec-tools kitty \
    kvantum lbzip2 less libnotify libva-utils linux-firmware liquidctl lldb lm_sensors \
    lnav lolcat loupe lowdown lshw lsof lsp-plugins lua lvm2 man-pages mangohud matugen \
    media-player-info mediainfo memtester meson miller minicom moreutils mpc mpd mpv mtr \
    nano ncdu neomutt neovim netcat nethack nethogs network-manager-applet nicotine+ \
    ninja-build nm-connection-editor nmap nodejs nodejs-npm nss-mdns nuspell nvtop \
    onefetch openblas openocd openrgb openssh optipng papers par parallel parted pass \
    pastel patchelf pavucontrol pbzip2 pcmanfm pcsc-tools perf perl-Image-ExifTool pgcli \
    picard pigz pipewire pipx plocate pngquant podman powertop pre-commit prettyping \
    progress pv pwgen python3-faker python3-mutagen python3-numpy python3-orjson \
    python3-poetry python3-pyperclip python3-textual qemu qpwgraph qrencode \
    qt5-qtwayland qt5ct qt6-qtwayland qt6ct rclone recoll reptyr ripgrep rlwrap rmlint rofi \
    rsync ruby ruff rust s-tui sad samba schedtool shfmt showtime simple-scan skopeo \
    slirp4netns slurp smartmontools snapshot socat sonic-visualiser sox sshpass strace \
    streamlink stress-ng subversion sudo sushi swayimg sysstat system-config-printer \
    tailscale tcpdump tealdeer tecla tesseract tesseract-langpack-eng \
    tesseract-langpack-rus testdisk tig tmux toilet traceroute transmission tree \
    tree-sitter-cli ttyd tumbler udiskie ufw ugrep unbound unzip upower urlscan urlwatch \
    uv valgrind vdirsyncer vim virt-manager virt-viewer vnstat w3m waypipe wayvnc wev \
    wf-recorder wget wget2 which whois wiremix wireshark-cli wl-clipboard wlr-randr wofi \
    wtype xdg-user-dirs-gtk xdg-utils xfsprogs xorg-x11-drv-amdgpu xorg-x11-drv-ati \
    xorg-x11-server-Xorg xorg-x11-xinit yamllint ydotool yelp zathura zathura-pdf-poppler \
    zbar zmap zoxide zram-generator zsh && \
    rpm-ostree cleanup -m

LABEL org.opencontainers.image.title="bluefin-custom"
LABEL org.opencontainers.image.description="Silverblue + 337 RPM packages"

# ── Stage 2: Host-built binaries ──────────────────────────────────
FROM rpm-layer AS full-layer

ADD hyprland-binaries.tar.gz /
RUN ldconfig 2>/dev/null || true

# Symlinks from symlinks.txt
COPY symlinks.txt /tmp/symlinks.txt
RUN while read -r src dst; do \
      [ -n "$src" ] && ln -sf "/usr/bin/$src" "/usr/bin/$dst" 2>/dev/null; \
    done < /tmp/symlinks.txt && rm /tmp/symlinks.txt; \
    ln -sf /usr/bin/delta /usr/bin/git-delta 2>/dev/null; \
    ln -sf /opt/v2rayN/v2rayN /usr/bin/v2rayN 2>/dev/null; \
    true

# Size cleanup
RUN rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/info/* \
    /usr/share/locale/* /usr/lib*/*.a /usr/lib*/*.la \
    /root/.cache /tmp/* /var/cache/dnf/* 2>/dev/null || true

LABEL org.opencontainers.image.title="bluefin-custom-full"
LABEL org.opencontainers.image.description="+ 156 host-built packages"

# ── Stage 3: Configs ──────────────────────────────────────────────
FROM full-layer AS with-configs

ADD dotfiles.tar.gz /etc/skel/
ADD dotfiles.tar.gz /root/

COPY system-configs.tar.gz /tmp/
RUN tar xzf /tmp/system-configs.tar.gz -C / && rm /tmp/system-configs.tar.gz

RUN cat > /usr/bin/apply-dotfiles << 'SCRIPT'
#!/bin/bash
if [ ! -f "$HOME/.config/chezmoi-applied" ]; then
  [ -d /etc/skel/.config ] && cp -a /etc/skel/.bashrc /etc/skel/.zshenv \
    /etc/skel/.p10k.zsh /etc/skel/.npmrc /etc/skel/.mpdasrc "$HOME/" 2>/dev/null
  [ -d /etc/skel/.config ] && cp -a /etc/skel/.config/* "$HOME/.config/" 2>/dev/null
  [ -d /etc/skel/.local ] && cp -a /etc/skel/.local/* "$HOME/.local/" 2>/dev/null
  touch "$HOME/.config/chezmoi-applied"
  echo "✅ Dotfiles applied"
fi
SCRIPT
RUN chmod +x /usr/bin/apply-dotfiles
RUN echo '[ -f /usr/bin/apply-dotfiles ] && /usr/bin/apply-dotfiles' >> /etc/skel/.bashrc
RUN echo '[ -f /usr/bin/apply-dotfiles ] && /usr/bin/apply-dotfiles' >> /etc/skel/.zshenv

LABEL org.opencontainers.image.title="bluefin-custom-with-configs"
LABEL org.opencontainers.image.description="+ dotfiles + first-boot setup"
LABEL org.opencontainers.image.version="${VERSION:-latest}"
LABEL org.opencontainers.image.created="$(date -Iseconds)"

# ── Gopass first-boot init ───────────────────────────────────────
RUN cat > /usr/bin/gopass-init << 'INIT'
#!/bin/bash
# Clone gopass store on first login
GOPASS_STORE="${GOPASS_STORE:-github.com/neg-serg/pass-store}"
if [ ! -d "$HOME/.local/share/gopass/stores/root" ] && command -v gopass >/dev/null; then
  echo "🔐 Initializing gopass..."
  gopass clone "$GOPASS_STORE" 2>/dev/null || echo "⚠️ gopass clone failed — run manually with: gopass clone $GOPASS_STORE"
fi
INIT
RUN chmod +x /usr/bin/gopass-init
RUN echo '[ -f /usr/bin/gopass-init ] && /usr/bin/gopass-init' >> /etc/skel/.bashrc
RUN echo '[ -f /usr/bin/gopass-init ] && /usr/bin/gopass-init' >> /etc/skel/.zshenv
