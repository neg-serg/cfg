# ═══════════════════════════════════════════════════════════════════
# Bluefin Custom Image — RPM-ONLY (Fedora + RPM Fusion + Hyprland COPR)
# All packages via rpm-ostree. No flatpak/cargo/pip/go/npm/source.
FROM ghcr.io/ublue-os/bluefin-dx:latest

# ── Disable broken/slow repos ──────────────────────────────────────
RUN rm -f /etc/yum.repos.d/*multimedia* /etc/yum.repos.d/*negativo* /etc/yum.repos.d/*rpmfusion* 2>/dev/null || true

# ── RPM Fusion free ────────────────────────────────────────────────
# ADD fetches from host network (works even if container can't reach external)
COPY rpmfusion-free.rpm /tmp/rpmfusion-free.rpm
RUN rpm-ostree install -y /tmp/rpmfusion-free.rpm && rpm-ostree cleanup -m && rm /tmp/rpmfusion-free.rpm || true



# ── NOTE: Hyprland excluded (COPR solopasha deps conflict with Fedora 44)
