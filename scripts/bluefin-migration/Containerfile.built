# Generated Bluefin custom image Containerfile
# Source packages: 414 mapped + 145 unavailable
#  RPM: 335 Flatpak: 11 Brew: 16
#  Cargo: 31 Pip: 20 Go: 1

FROM ghcr.io/ublue-os/bluefin-dx:latest

# ── Disable broken repos ────────────────────────────────────
RUN rm -f /etc/yum.repos.d/*multimedia* /etc/yum.repos.d/*negativo* 2>/dev/null || true

# ── RPM Fusion disabled (network unavailable) ───────────────
# RUN rpm-ostree install -y https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm

