# ── Source builds (16 total) ───────────
# bucklespring
RUN dnf install -y gcc make libpulse-devel libxtst-devel && \
    git clone --depth=1 https://github.com/zevv/bucklespring.git /tmp/build-bucklespring && \
    cd /tmp/build-bucklespring && \
    make && install -m755 buckle /usr/local/bin/ && \
    rm -rf /tmp/build-bucklespring

# dualsensectl
RUN dnf install -y gcc meson ninja-build pkgconfig(sdl2) pkgconfig(libudev) pkgconfig(dbus-1) pkgconfig(hidapi-hidraw) && \
    git clone --depth=1 https://github.com/nowrep/dualsensectl.git /tmp/build-dualsensectl && \
    cd /tmp/build-dualsensectl && \
    meson setup builddir && ninja -C builddir && ninja -C builddir install && \
    rm -rf /tmp/build-dualsensectl

# hxd
RUN dnf install -y gcc make lua-devel scdoc && \
    git clone --depth=1 https://github.com/schievel/hxd.git /tmp/build-hxd && \
    cd /tmp/build-hxd && \
    make && make install && \
    rm -rf /tmp/build-hxd

# mpdas
RUN dnf install -y gcc gcc-c++ make libcurl-devel libmpdclient-devel && \
    git clone --depth=1 https://github.com/hrkfdn/mpdas.git /tmp/build-mpdas && \
    cd /tmp/build-mpdas && \
    make && install -m755 mpdas /usr/local/bin/ && \
    rm -rf /tmp/build-mpdas

# neo-matrix
RUN dnf install -y gcc make autoconf automake ncurses-devel && \
    git clone --depth=1 https://github.com/st3w/neo.git /tmp/build-neo-matrix && \
    cd /tmp/build-neo-matrix && \
    autoreconf -fi && ./configure && make && make install && \
    rm -rf /tmp/build-neo-matrix

# newsraft
RUN dnf install -y gcc make ncurses-devel libcurl-devel expat-devel sqlite-devel && \
    git clone --depth=1 https://github.com/newsraft/newsraft.git /tmp/build-newsraft && \
    cd /tmp/build-newsraft && \
    make && make install && \
    rm -rf /tmp/build-newsraft

# pipemixer-git
RUN dnf install -y gcc meson ninja-build pipewire-devel ncurses-devel && \
    git clone --depth=1 https://github.com/nickelc/pipemixer.git /tmp/build-pipemixer-git && \
    cd /tmp/build-pipemixer-git && \
    meson setup builddir && ninja -C builddir && ninja -C builddir install && \
    rm -rf /tmp/build-pipemixer-git

# rofi-file-browser-extended-git
RUN dnf install -y gcc cmake make rofi-devel && \
    git clone --depth=1 https://github.com/marvinkreis/rofi-file-browser-extended.git /tmp/build-rofi-file-browser-extended-git && \
    cd /tmp/build-rofi-file-browser-extended-git && \
    mkdir build && cd build && cmake .. && make && make install && \
    rm -rf /tmp/build-rofi-file-browser-extended-git

# tanin-git
RUN dnf install -y cargo alsa-lib-devel openssl-devel && \
    git clone --depth=1 https://github.com/kamiyaa/tanin.git /tmp/build-tanin-git && \
    cd /tmp/build-tanin-git && \
    cargo build --release --no-default-features && install -m755 target/release/tanin /usr/local/bin/ && \
    rm -rf /tmp/build-tanin-git

# tessen
RUN git clone --depth=1 https://github.com/ayushnix/tessen.git /tmp/build-tessen && \
    cd /tmp/build-tessen && \
    PREFIX=/usr/local make install && \
    rm -rf /tmp/build-tessen

# xdg-ninja
RUN git clone --depth=1 https://github.com/b3nj5m1n/xdg-ninja.git /tmp/build-xdg-ninja && \
    cd /tmp/build-xdg-ninja && \
    install -Dm755 xdg-ninja.sh /usr/local/bin/xdg-ninja && cp -r scripts /usr/local/share/xdg-ninja/ && \
    rm -rf /tmp/build-xdg-ninja

# ytsurf
RUN dnf install -y golang && \
    git clone --depth=1 https://github.com/irevenko/ytsurf.git /tmp/build-ytsurf && \
    cd /tmp/build-ytsurf && \
    go build -o ytsurf cmd/ytsurf/main.go && install -m755 ytsurf /usr/local/bin/ && \
    rm -rf /tmp/build-ytsurf

# zapret2
RUN dnf install -y gcc make && \
    git clone --depth=1 https://github.com/bol-van/zapret.git /tmp/build-zapret2 && \
    cd /tmp/build-zapret2 && \
    cd ip2net && make && install -m755 ip2net /usr/local/bin/ && \
    rm -rf /tmp/build-zapret2


# ── Flatpak apps (11 total) ─────────────
RUN flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo && \
  flatpak install -y flathub app.zen_browser.zen com.bazecor.Bazecor com.dosbox.DOSBox com.rawtherapee.RawTherapee net.lutris.Lutris org.blender.Blender org.chromium.Chromium org.gimp.GIMP org.localsend.localsend_app org.mozilla.firefox org.telegram.desktop

