# ═══════════════════════════════════════════════════════════════════
# Config layer — dotfiles + system configs + first-boot chezmoi setup
# ═══════════════════════════════════════════════════════════════════
FROM localhost/bluefin-custom-full:latest

# ── Dotfiles ──────────────────────────────────────────────────────
ADD dotfiles.tar.gz /etc/skel/
# Also copy to root for immediate use during build tests
ADD dotfiles.tar.gz /root/

# ── System configs (Salt files + scripts) ────────────────────────
COPY system-configs.tar.gz /tmp/
RUN tar xzf /tmp/system-configs.tar.gz -C / && rm /tmp/system-configs.tar.gz

# ── First-boot service: apply dotfiles to new user ────────────────
RUN mkdir -p /etc/skel/.config /etc/skel/.local/share

# chezmoi init script for new users
RUN cat > /usr/bin/apply-dotfiles << 'SCRIPT'
#!/bin/bash
# Apply chezmoi-managed dotfiles on first login
if [ ! -f "$HOME/.config/chezmoi-applied" ]; then
  if [ -d /etc/skel/.config ]; then
    cp -a /etc/skel/.bashrc /etc/skel/.zshenv /etc/skel/.p10k.zsh \
          /etc/skel/.npmrc /etc/skel/.mpdasrc "$HOME/" 2>/dev/null
    cp -a /etc/skel/.config/* "$HOME/.config/" 2>/dev/null
    cp -a /etc/skel/.local/* "$HOME/.local/" 2>/dev/null
  fi
  touch "$HOME/.config/chezmoi-applied"
  echo "✅ Dotfiles applied"
fi
SCRIPT
RUN chmod +x /usr/bin/apply-dotfiles

# ── Auto-apply for new bash/zsh sessions ──────────────────────────
RUN echo '[ -f /usr/bin/apply-dotfiles ] && /usr/bin/apply-dotfiles' >> /etc/skel/.bashrc
RUN echo '[ -f /usr/bin/apply-dotfiles ] && /usr/bin/apply-dotfiles' >> /etc/skel/.zshenv

LABEL org.opencontainers.image.title="bluefin-custom-with-configs"
LABEL org.opencontainers.image.description="Bluefin + packages + dotfiles + first-boot setup"
