# ── Google Chrome RPM repo ──────────────────────────────
RUN cat > /etc/yum.repos.d/google-chrome.repo <<'EOF'
[google-chrome]
name=google-chrome
baseurl=https://dl.google.com/linux/chrome/rpm/stable/x86_64
enabled=1
gpgcheck=1
gpgkey=https://dl.google.com/linux/linux_signing_key.pub
EOF

# ── COPR repos ──────────────────────────────────────────
RUN curl -sLo /etc/yum.repos.d/_copr_amneziavpn-amneziawg.repo \
    https://copr.fedorainfracloud.org/coprs/amneziavpn/amneziawg/repo/fedora-$(rpm -E %fedora)/amneziavpn-amneziawg-fedora-$(rpm -E %fedora).repo
RUN curl -sLo /etc/yum.repos.d/_copr_ryanabx-cosmic-epoch.repo \
    https://copr.fedorainfracloud.org/coprs/ryanabx/cosmic-epoch/repo/fedora-$(rpm -E %fedora)/ryanabx-cosmic-epoch-fedora-$(rpm -E %fedora).repo
RUN curl -sLo /etc/yum.repos.d/_copr_errornointernet-packages.repo \
    https://copr.fedorainfracloud.org/coprs/errornointernet/packages/repo/fedora-$(rpm -E %fedora)/errornointernet-packages-fedora-$(rpm -E %fedora).repo
RUN curl -sLo /etc/yum.repos.d/_copr_duament-sing-box.repo \
    https://copr.fedorainfracloud.org/coprs/duament/sing-box/repo/fedora-$(rpm -E %fedora)/duament-sing-box-fedora-$(rpm -E %fedora).repo
RUN curl -sLo /etc/yum.repos.d/_copr_erikreider-SwayNotificationCenter.repo \
    https://copr.fedorainfracloud.org/coprs/erikreider/SwayNotificationCenter/repo/fedora-$(rpm -E %fedora)/erikreider-SwayNotificationCenter-fedora-$(rpm -E %fedora).repo
RUN curl -sLo /etc/yum.repos.d/_copr_nicknamenull-v2raya.repo \
    https://copr.fedorainfracloud.org/coprs/nicknamenull/v2raya/repo/fedora-$(rpm -E %fedora)/nicknamenull-v2raya-fedora-$(rpm -E %fedora).repo

# ── Extra RPMs (8 total) ────────────
RUN rpm-ostree install -y \
    amneziawg-dkms \
    amneziawg-tools \
    cosmic-greeter \
    google-chrome-stable \
    satty \
    sing-box \
    swayosd \
    v2raya && \
    rpm-ostree cleanup -m

# ── NPM global (1 total) ──────────────────
RUN npm install -g @anthropic-ai/claude-code

# ── Extra Cargo (12 total) ────────────
RUN cargo binstall -y amdgpu_top hyprscratch lutgen regex-tui rmpc rustmission systemd-manager-tui youtube-tui otter-launcher wlr-which-key oyo tmmpr

# ── Extra Pip (7 total) ───────────────────
RUN pipx install cmake-language-server dool epr-reader mpDris2 patool protonvpn-cli raysession

# ── Extra Go (5 total) ─────────────────────
RUN go install github.com/Mic92/ssh-to-age/cmd/ssh-to-age@latest
RUN go install github.com/boyter/scc/v3@latest
RUN go install github.com/laurent22/massren@latest
RUN go install github.com/derat/unflac@latest
RUN go install github.com/irevenko/ytsurf@latest

