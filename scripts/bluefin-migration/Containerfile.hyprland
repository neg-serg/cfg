# ═══════════════════════════════════════════════════════════════════
# Hyprland + ecosystem — single-script source build
# Extracts .pc files from -devel RPMs without installing them
# ═══════════════════════════════════════════════════════════════════
FROM localhost/bluefin-custom:latest

# Install build tools and NON-mesa deps only
RUN rpm-ostree install -y \
    cmake gcc-c++ meson ninja-build \
    wayland-devel wayland-protocols-devel \
    libxkbcommon-devel pango-devel cairo-devel \
    libdrm-devel libinput-devel libxcb-devel \
    libuuid-devel libseat-devel libglvnd-devel \
    pugixml-devel libdisplay-info-devel libzip-devel \
    librsvg2-devel libwebp-devel file-devel \
    libjpeg-turbo-devel libpng-devel \
    libXcursor-devel libXdmcp-devel libXtst-devel \
    tomlplusplus-devel git curl cpio && \
    rpm-ostree cleanup -m

# Build ALL Hyprland components in ONE script
# Downloads -devel RPMs to extract .pc files, avoids Mesa version conflict
RUN set -eux; \
    mkdir -p /tmp/hb /tmp/pc /tmp/pc-pkgconfig; \
    \
    # Download mesa-libgbm-devel and hwdata-devel to extract .pc files
    dnf download -y --destdir=/tmp/pc mesa-libgbm-devel hwdata-devel 2>/dev/null || true; \
    for rpm in /tmp/pc/*.rpm; do \
      [ -f "$rpm" ] && rpm2cpio "$rpm" | cpio -idmv -D /tmp/pc/extract 2>/dev/null; \
    done; \
    find /tmp/pc/extract -name '*.pc' -exec cp {} /tmp/pc-pkgconfig/ \; 2>/dev/null || true; \
    # Also try standard location
    cp /usr/lib64/pkgconfig/gbm.pc /tmp/pc-pkgconfig/ 2>/dev/null || true; \
    cp /usr/share/pkgconfig/hwdata.pc /tmp/pc-pkgconfig/ 2>/dev/null || true; \
    export PKG_CONFIG_PATH=/tmp/pc-pkgconfig:/usr/lib64/pkgconfig:/usr/share/pkgconfig; \
    \
    cd /tmp/hb; \
    \
    build_hypr() { \
      local name=$1 url=$2; \
      echo "=== Building $name ==="; \
      git clone --depth=1 "$url" "$name"; \
      cd "$name"; \
      cmake -B b -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr; \
      cmake --build b -j$(nproc); \
      cmake --install b; \
      cd /tmp/hb; \
      rm -rf "$name"; \
    }; \
    \
    build_hypr hyprutils    https://github.com/hyprwm/hyprutils; \
    build_hypr hyprlang     https://github.com/hyprwm/hyprlang; \
    build_hypr hyprcursor   https://github.com/hyprwm/hyprcursor; \
    build_hypr hyprwayland-scanner https://github.com/hyprwm/hyprwayland-scanner; \
    build_hypr hyprgraphics https://github.com/hyprwm/hyprgraphics; \
    CFLAGS="-I/usr/include" CXXFLAGS="-I/usr/include" build_hypr aquamarine   https://github.com/hyprwm/aquamarine; \
    CFLAGS="-I/usr/include" CXXFLAGS="-I/usr/include" build_hypr Hyprland     https://github.com/hyprwm/Hyprland; \
    build_hypr hypridle     https://github.com/hyprwm/hypridle; \
    build_hypr hyprlock     https://github.com/hyprwm/hyprlock; \
    build_hypr hyprpicker   https://github.com/hyprwm/hyprpicker; \
    build_hypr hyprpolkitagent https://github.com/hyprwm/hyprpolkitagent; \
    build_hypr xdg-desktop-portal-hyprland https://github.com/hyprwm/xdg-desktop-portal-hyprland; \
    \
    rm -rf /tmp/hb /tmp/pc; \
    echo "All 12 Hyprland components built successfully"

RUN rpm-ostree cleanup -m || true

LABEL org.opencontainers.image.title="bluefin-custom-hyprland"
LABEL org.opencontainers.image.description="Hyprland 12 components source-built"
